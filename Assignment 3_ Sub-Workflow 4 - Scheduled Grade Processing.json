      "parameters": {
        "jsCode": "// Calculate class average and classify each student's grade status\nconst items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\n// Parse numeric grades, defaulting invalid/missing values to 0\nconst grades = items.map(item => {\n  const raw = item.json.Grade ?? item.json.grade ?? item.json.Score ?? item.json.score;\n  const num = parseFloat(raw);\n  return isNaN(num) ? 0 : num;\n});\n\nconst classAverage = grades.reduce((sum, g) => sum + g, 0) / grades.length;\n\n// Classify each student\nconst results = items.map((item, index) => {\n  const grade = grades[index];\n  let gradeStatus;\n\n  if (grade >= 90) {\n    gradeStatus = 'Distinction';\n  } else if (grade >= 50) {\n    gradeStatus = 'Pass';\n  } else {\n    gradeStatus = 'Fail';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      grade: grade,\n      classAverage: Math.round(classAverage * 100) / 100,\n      gradeStatus: gradeStatus\n    }\n  };\n});\n\nreturn results;"
      },
