    },
    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body || item.json;\n\n  const studentId = body.studentId ?? body['Student ID'];\n  const studentName = body.studentName ?? body['Student Name'] ?? '';\n  const email = body.email ?? body['Email'] ?? '';\n  const classesAttended = Number(body.classesAttended ?? body['Classes Attended'] ?? 0);\n  const totalClasses = Number(body.totalClasses ?? body['Total Classes'] ?? 0);\n\n  let attendancePercentage = 0;\n  if (totalClasses > 0) {\n    attendancePercentage = Math.round((classesAttended / totalClasses) * 10000) / 100;\n  }\n\n  items.push({\n    json: {\n      studentId,\n      studentName,\n      email,\n      classesAttended,\n      totalClasses,\n      attendancePercentage,\n      calculatedAt: new Date().toISOString()\n    }\n  });\n}\n\nreturn items;"
      },
